<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.osfans.mcpdict.UI.RecyclerView
        android:id="@+id/index_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:scrollbars="horizontal" />

    <View
        android:id="@+id/index_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Original result list. -->
        <com.osfans.mcpdict.UI.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <!-- Matrix: top header and left label column are frozen. -->
        <com.osfans.mcpdict.UI.PagerSwipeBlockLayout
            android:id="@+id/matrix_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/matrix_header_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Top-left corner: export/copy table -->
				<FrameLayout
					android:id="@+id/matrix_corner"
					android:layout_width="wrap_content"
					android:layout_height="match_parent">

					<TextView
						android:id="@+id/matrix_export"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:gravity="center"
						android:text="📤"
						android:textSize="18sp"
						android:clickable="true"
						android:focusable="true"
						android:foreground="?android:attr/selectableItemBackgroundBorderless"
						android:contentDescription="複製或匯出表格" />

				</FrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/matrix_header_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:scrollbars="none" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/matrix_body_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:scrollbars="none" />

                <!--
                    Real draggable horizontal scrollbar for the matrix.
                    It overlays the bottom edge, appears while horizontal scrolling,
                    and fades about one second after interaction stops.
                    ResultFragment dynamically aligns its left edge with the frozen
                    first column.
                -->
                <SeekBar
                    android:id="@+id/matrix_horizontal_scrollbar"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom"
                    android:alpha="0"
                    android:max="1"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:visibility="invisible" />

            </FrameLayout>
        </com.osfans.mcpdict.UI.PagerSwipeBlockLayout>
    </FrameLayout>
</LinearLayout>
